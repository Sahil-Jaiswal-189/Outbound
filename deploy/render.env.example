# One Docker web service; attach a persistent disk at /var/data.
# These runtime values are already defaults in the image/entrypoint.
HOST=0.0.0.0
DATA_DIR=/var/data
DB_PATH=/var/data/outbound.db
OLLAMA_MODEL=qwen2.5:3b
TABPFN_DEVICE=cpu
TABPFN_MIN_ROWS=30
TABPFN_CACHE_SIZE=2
TABPFN_TIMEOUT_MS=90000
OLLAMA_TIMEOUT_MS=60000

# Insert your credentials in Render's dashboard, not in this file.
ORS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Optional custom domain; otherwise Render's external URL is detected.
PUBLIC_ORIGIN=

# Do not set PORT or NODE_VERSION: Render supplies PORT; Docker pins Node.
# Internal URLs are set by the entrypoint, not by another Render service:
# OLLAMA_URL=http://127.0.0.1:11434
# TABPFN_URL=http://127.0.0.1:8008
