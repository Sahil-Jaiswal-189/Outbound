# Optional local open-weight quest generation
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional live grounding
SERPAPI_KEY=

# Optional personal quest ranker
TABPFN_URL=http://127.0.0.1:8008
# These settings apply to the Python process (included in the Docker deployment).
TABPFN_MIN_ROWS=30
TABPFN_DEVICE=cpu
TABPFN_CACHE_SIZE=4

# Structured local knowledge (weather and places need no API key)
ORS_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Standard public endpoint automatically fails over to private.coffee.
# Custom endpoints do not fail over unless explicitly configured here.
# Uncomment an empty value to disable public failover.
# OVERPASS_FALLBACK_URL=

# Defaults to data/outbound.db when omitted
DB_PATH=

# Optional spoken reward messages
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Server
PORT=5177
# Use 0.0.0.0 on Render; keep localhost for local-only use.
HOST=127.0.0.1
# Optional canonical browser origin, e.g. https://outbound.example.com.
# Render's RENDER_EXTERNAL_URL is used automatically when this is omitted.
PUBLIC_ORIGIN=
